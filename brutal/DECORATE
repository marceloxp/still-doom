// Pump magazine. Brutal stops at 9. Same reload, but the jumps are labels
// so they cannot fall through into the original stop-at-9 states.

ACTOR YardShotgunAmmo : ShotgunAmmo replaces ShotgunAmmo
{
	Inventory.MaxAmount 20
	Ammo.BackpackMaxAmount 20
}

ACTOR YardPump : Shot_Gun replaces Shot_Gun
{
	States
	{
	Reload:
		SHTN A 0
		SHTN A 0 A_TakeInventory("Reloading", 1)
		SHTN A 0 A_JumpIfInventory("AmmoShell", 1, "ReloadZoom")
		Goto NoAmmo
	ReloadZoom:
		SHTN A 0 A_TakeInventory("Zoomed", 1)
		SHTN A 0 A_ZoomFactor(1.0)
		SHTN A 1 A_WeaponReady
		SHTN A 0 A_JumpIfInventory("ShotgunAmmo", 20, "OkToFire")
		SHTN A 0 A_JumpIfInventory("ShotgunAmmo", 1, "ReloadNormally")
		SHTN A 0 A_GiveInventory("ShotgunWasEmpty", 1)
		Goto ReloadNormally
	ReloadNormally:
		SHTN A 0 A_JumpIfInventory("AmmoShell", 1, "ReloadHasReserve")
		Goto Ready
	ReloadHasReserve:
		SHTN A 0 A_JumpIfInventory("TurboReload", 1, "TurboReload")
		SHTN B 1 A_GiveInventory("Pumping", 1)
		SHTN CDE 1
		Goto InsertingShells
	InsertingShells:
		SHTN A 0 A_JumpIfInventory("AmmoShell", 1, "InsertHasShell")
		Goto Pump2
	InsertHasShell:
		SHTN A 0 A_GiveInventory("Pumping", 1)
		SSHR A 0 A_TakeInventory("Reloading", 1)
		SHTN A 0 A_JumpIfInventory("ShotgunAmmo", 20, "FinishedInsertingShells")
		SHTN A 0 A_GiveInventory("ShotgunAmmo", 1)
		SHTN A 0 A_TakeInventory("AmmoShell", 1)
		Goto InsertShellAnimation
	InsertShellAnimation:
		SHTN A 0
		SSHR AAABC 1
		SSHR D 1 A_PlaySound("insertshell")
		SSHR EF 1 A_WeaponReady(WRF_NOBOB)
		SSHR A 0 A_JumpIfInventory("Reloading", 1, "Pump2")
		SHTN A 0 A_JumpIfInventory("Kicking", 1, "DoKickReloading")
		SHTN A 0 A_JumpIfInventory("IsRunning", 1, "CheckSprint")
		Goto InsertingShells
	FinishedInsertingShells:
		SHTN A 0 A_TakeInventory("Reloading", 1)
		SHTN A 0 A_JumpIfInventory("ShotgunWasEmpty", 1, "Pump2")
		SHTN FEDCBA 1 A_WeaponReady
		SHTN A 0 A_TakeInventory("Reloading", 1)
		Goto Ready
	TurboReload:
		SHSS BC 0
		Goto TurboBullets
	TurboBullets:
		SHTN A 0 A_JumpIfInventory("ShotgunAmmo", 20, "FinishTurboReload")
		SHTN A 0 A_JumpIfInventory("AmmoShell", 1, "TurboGive")
		Goto FinishTurboReload
	TurboGive:
		SHTN A 0 A_GiveInventory("ShotgunAmmo", 1)
		SHTN A 0 A_TakeInventory("AmmoShell", 1)
		Goto TurboBullets
	FinishTurboReload:
		SHTN A 1
		SHTN A 1 A_Refire
		Goto Ready3
	TurboReload2:
		SHSS BC 0
		Goto TurboBullets2
	TurboBullets2:
		SHTN A 0 A_JumpIfInventory("ShotgunAmmo", 20, "FinishTurboReload2")
		SHTN A 0 A_JumpIfInventory("AmmoShell", 1, "TurboGive2")
		Goto FinishTurboReload2
	TurboGive2:
		SHTN A 0 A_GiveInventory("ShotgunAmmo", 1)
		SHTN A 0 A_TakeInventory("AmmoShell", 1)
		Goto TurboBullets2
	FinishTurboReload2:
		SHT8 A 1 A_Refire
		Goto Ready2
	}
}
